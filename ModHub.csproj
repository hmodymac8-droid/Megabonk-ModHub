<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>ModHub</AssemblyName>
    <RootNamespace>ModHub</RootNamespace>
    <Version>1.2.3</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- Where Megabonk is installed. Override with: dotnet build -p:GameDir="D:\...\Megabonk" -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Megabonk</GameDir>
  </PropertyGroup>

  <!-- Thunderstore build: dotnet build -p:Edition=Thunderstore (no Nexus, no self-update), kept apart from the normal build. -->
  <PropertyGroup Condition="'$(Edition)' == 'Thunderstore'">
    <DefineConstants>$(DefineConstants);THUNDERSTORE</DefineConstants>
    <OutputPath>bin\Thunderstore\</OutputPath>
    <IntermediateOutputPath>obj\Thunderstore\</IntermediateOutputPath>
  </PropertyGroup>

  <!-- The installer is its own project (Installer\Installer.csproj). -->
  <ItemGroup>
    <Compile Remove="Installer\**" />
    <Compile Remove="nexus-review\**" />
    <!-- Backup copies and output folders: their .cs files must never be compiled into ModHub.dll. -->
    <Compile Remove="backup-*\**" />
    <Compile Remove="github-releases\**" />
    <Compile Remove="dist\**" />
    <EmbeddedResource Remove="Installer\**" />
    <None Remove="Installer\**" />
  </ItemGroup>

  <!-- Everything below comes from the player's own game install, so nothing is bundled into the DLL. -->
  <ItemGroup>
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\SemanticVersioning.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\Mono.Cecil.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\core\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(GameDir)\BepInEx\interop\*.dll" Private="false" />
  </ItemGroup>

</Project>
