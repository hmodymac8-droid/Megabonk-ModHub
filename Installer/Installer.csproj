<Project Sdk="Microsoft.NET.Sdk">

  <!-- "Mod Hub Installer.exe": one file with the All-in-One inside. Targets .NET Framework 4.8, which every
       Windows 10/11 already has, so players install nothing else. Build it with ModHub\build.ps1. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>Mod Hub Installer</AssemblyName>
    <RootNamespace>ModHubInstaller</RootNamespace>
    <Version>1.1.1</Version>
    <Product>Mod Hub Installer</Product>
    <Company>AhmedHus21</Company>
    <Description>Installs Mod Hub (with BepInEx) for Megabonk</Description>
    <Copyright>AhmedHus21</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Reproducible: the same source + the same All-in-One zip give a byte-identical exe in any folder. -->
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <PathMap>$(MSBuildProjectDirectory)=/src</PathMap>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceLink>false</EnableSourceLink>
    <!-- The All-in-One zip that gets installed (passed in by build.ps1). -->
    <Payload Condition="'$(Payload)' == ''">..\dist\payload.zip</Payload>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <EmbeddedResource Include="$(Payload)" LogicalName="payload.zip" />
    <EmbeddedResource Include="logo.png" LogicalName="logo.png" />
  </ItemGroup>

  <!-- .NET Framework 4.8 reference files as a package: the exe builds with only the .NET SDK (no 4.8 Developer Pack). -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The All-in-One zip is made by build.ps1 (dist\ is not in the repo): say so instead of a compiler error. -->
  <Target Name="CheckPayload" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(Payload)')" Text="No All-in-One zip to put inside the installer ($(Payload)). Build it with ..\build.ps1, which makes the zip first and then this exe." />
  </Target>

</Project>
